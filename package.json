{
  "name": "akcat-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:format": "node --experimental-strip-types --test tests/format.test.mjs",
    "test:config": "node --experimental-strip-types --test tests/api-origin.test.mjs",
    "test:directions": "node --experimental-strip-types --test tests/directions.test.mjs",
    "test:directions:browser": "node tests/run-auth.mjs --suite directions",
    "test:users:browser": "node tests/run-auth.mjs --suite users",
    "test:account:browser": "node tests/run-auth.mjs --suite account",
    "test:audit:browser": "node tests/run-auth.mjs --suite audit",
    "test:sales:math": "node --experimental-strip-types --test tests/sales-math.test.mjs",
    "test:auth:serve": "node --experimental-strip-types tests/serve-auth.mjs",
    "test:auth:browser": "node tests/run-auth.mjs",
    "test:customers:browser": "node tests/run-auth.mjs --suite customers",
    "test:products:browser": "node tests/run-auth.mjs --suite products",
    "test:sales:browser": "node tests/run-auth.mjs --suite sales",
    "test:finance:browser": "node tests/run-auth.mjs --suite finance",
    "test:corrections:browser": "node tests/run-auth.mjs --suite corrections",
    "test:reports:browser": "node tests/run-auth.mjs --suite reports",
    "test:adjustments:browser": "node tests/run-auth.mjs --suite adjustments",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.3"
  }
}
